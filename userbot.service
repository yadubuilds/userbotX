[Unit]
Description=Pyrogram Userbot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/pyrogram-userbot
ExecStart=/usr/bin/python3 /home/ubuntu/pyrogram-userbot/main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target